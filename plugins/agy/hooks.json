{
  "tcas": {
    "SessionStart": [
      {
        "type": "command",
        "command": "exec ./bin/tcas hook agy",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "exec ./bin/tcas hook agy",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "exec ./bin/tcas hook agy",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/tcas hook agy",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/tcas hook agy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/tcas hook agy",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/tcas hook agy",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "read_file|view_file|view_file_outline|view_code_item|grep_search|find_by_name|list_dir",
        "hooks": [
          {
            "type": "command",
            "command": "exec ./bin/tcas hook agy",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "exec ./bin/tcas hook agy",
        "timeout": 5
      }
    ]
  }
}
