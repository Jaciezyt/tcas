#!/usr/bin/env python3
# probe-wait N [label]: log start, sleep N seconds, log end, print a marker.
import os, sys, time
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import probe_agy_lib as lib

n = float(sys.argv[1]) if len(sys.argv) > 1 else 1.0
label = sys.argv[2] if len(sys.argv) > 2 else ""
details = lib.ancestor_details()
lib.log({
    "event": "bin-wait-start",
    "label": label,
    "ts": time.time(),
    "pid": os.getpid(),
    "ancestors": [d["pid"] for d in details],
    "env": {k: os.environ.get(k) for k in lib.ENV_KEYS},
})
time.sleep(n)
lib.log({"event": "bin-wait-end", "label": label, "ts": time.time()})
print("PROBE-WAIT-DONE %s" % label)
