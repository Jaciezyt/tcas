#!/usr/bin/env python3
# probe-wait N [label]: log start, sleep N seconds, log end, print a marker.
import os, sys, time, importlib.util
here = os.path.dirname(os.path.realpath(__file__))
spec = importlib.util.spec_from_file_location("probe_lib", os.path.join(here, "probe-lib.py"))
lib = importlib.util.module_from_spec(spec); spec.loader.exec_module(lib)
n = float(sys.argv[1]) if len(sys.argv) > 1 else 1
label = sys.argv[2] if len(sys.argv) > 2 else ""
lib.log({"event": "bin-wait-start", "label": label, "ts": time.time(), "pid": os.getpid(), "ancestors": lib.ancestors(),
         "env": {k: os.environ.get(k) for k in ["TCAS_SESSION", "CLAUDE_CODE_SESSION_ID"]}})
time.sleep(n)
lib.log({"event": "bin-wait-end", "label": label, "ts": time.time()})
print("PROBE-WAIT-DONE %s" % label)
